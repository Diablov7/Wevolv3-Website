# Wevolv3 Website Redirects
# Static HTML site with Sanity blog integration

# Blog redirects
/blog.html    /blog.html    200

# Clean blog URLs: /blog/<slug> serve o shell do artigo (fallback; a edge function
# inject-og-tags injeta as meta tags e faz o 301 das URLs antigas ?slug=)
/blog/*   /singleblog.html   200

# /singleblog sem slug -> shell do artigo
/singleblog   /singleblog.html    200

# Legacy redirects (if any old URLs exist)
/blog-post    /blog.html    301
/blog-post.html    /blog.html    301

# Sanity Studio - Servir localmente
# Arquivos estáticos do Studio têm prioridade (! = force)
/studio/static/*  /studio/static/:splat  200!
/studio/*         /studio/index.html     200!
/studio           /studio/index.html     200!

# SPA fallback (deve ser o último)
# Exclui arquivos estáticos automaticamente
/*    /index.html   200
